<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext allowed so a Cloudlog/Wavelog instance on the local network
     (http://192.168.x.x) can be reached. Public services still use TLS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
